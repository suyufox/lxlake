# 编辑器统一约定，保证不同 IDE/系统下的文件格式一致。
# 与 .gitattributes 配合：仓库内一律 LF。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4
max_line_length = 100

[*.{toml,lock}]
indent_size = 2

[*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css,scss,html}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

# Markdown 中行尾两个空格表示换行，不能裁剪
[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf